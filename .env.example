# PostgreSQL (pooled URL for serverless; DIRECT_URL is the non-pooled migration URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/energy?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/energy"

# Auth and app
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional scheduled stale-device checks (Vercel Cron sends Bearer CRON_SECRET)
CRON_SECRET="replace-with-at-least-16-random-characters"

# Development-only. Must remain false in production.
ALLOW_SIMULATED_TELEMETRY="false"

# Live dashboard polling (serverless-compatible; not a WebSocket server)
LIVE_POLL_INTERVAL_MS="8000"
STALE_AFTER_SECONDS="120"

# Encrypt device connection secrets at rest (AES-256-GCM). Min 32 characters.
CREDENTIALS_ENCRYPTION_KEY="replace-with-at-least-32-random-characters!!"

# Optional email alerts via Resend
RESEND_API_KEY=""
ALERT_FROM_EMAIL=""

# Paystack (Nigeria-eligible). Verify webhooks with PAYSTACK_WEBHOOK_SECRET.
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Optional flag documenting MQTT bridge intent (persistent client runs on gateway)
MQTT_BRIDGE_ENABLED="false"

# --- Vercel production ---
# APP_URL="https://your-app.vercel.app"
# ALLOW_SIMULATED_TELEMETRY="false"
# NODE_ENV="production"
#
# WebSocket does NOT run inside Vercel serverless. ESP should use HTTPS:
#   POST https://your-app.vercel.app/api/v1/telemetry
# Optional: host realtime elsewhere, then set:
# NEXT_PUBLIC_REALTIME_WS_URL="wss://realtime.yourdomain.com"
# REALTIME_INTERNAL_URL="https://realtime.yourdomain.com"
# REALTIME_INTERNAL_SECRET="same-as-or-derived-from-auth-secret"
# REALTIME_PORT="3001"

# Gateway agent (see gateway/ and docs/gateway-raspberry-pi.md)
# ENERGYMONITOR_URL="http://localhost:3000"
# GATEWAY_TOKEN="gw_xxx.secret"
